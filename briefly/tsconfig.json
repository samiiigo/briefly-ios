{
  "extends": "./node_modules/expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*", "./app/*"],
      "@root/*": ["./*"],
      "@app-types/*": ["./src/types/*"],
      "@app-types": ["./src/types/index", "./src/types"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts"
  ]
}
