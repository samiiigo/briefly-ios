# Public client config (safe to embed):
EXPO_PUBLIC_SUPABASE_URL=https://vcuvfstcobxujjrvqpop.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional crash reporting (Sentry). Leave empty to keep crashReporter as a no-op.
EXPO_PUBLIC_SENTRY_DSN=

# Server-only secrets belong in Supabase Edge Function secrets:
# ASSEMBLYAI_API_KEY
# OPENROUTER_SHARED_API_KEY
