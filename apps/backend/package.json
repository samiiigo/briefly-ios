{
  "name": "@briefly/backend",
  "private": true,
  "version": "0.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "supabase:deploy": "bash ./scripts/supabase-deploy.sh",
    "supabase:db:push": "npx supabase db push --workdir ./supabase",
    "supabase:functions:deploy": "npx supabase functions deploy --workdir ./supabase"
  },
  "dependencies": {
    "@briefly/config": "workspace:*",
    "@briefly/types": "workspace:*",
    "@briefly/validation": "workspace:*",
    "@supabase/supabase-js": "^2.49.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "typescript": "~5.9.2"
  }
}
