{
  "extends": "@briefly/typescript-config/react-native.json",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./app/*"],
      "@features/*": ["./src/features/*"],
      "@shared/*": ["./src/shared/*"],
      "@navigation/*": ["./src/navigation/*"],
      "@providers/*": ["./src/providers/*"],
      "@store/*": ["./src/store/*"],
      "@api/*": ["./src/api/*"],
      "@root/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.d.ts"],
  "exclude": ["node_modules", "supabase/functions"]
}
